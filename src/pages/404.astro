---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Stránka nenájdená | BÄM!" description="Hľadaná stránka neexistuje.">
  <section class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-4xl font-bold mb-4">404</h1>
    <p class="mb-6 text-neutral-600">Stránka, ktorú hľadáte, neexistuje alebo bola premiestnená.</p>
    <a href="/" class="px-6 py-3 bg-black text-white rounded-lg hover:opacity-90 transition">
      Späť na domov
    </a>
  </section>
</BaseLayout>
