---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getProjectsAndImages, type ProjectWithImages } from "../../lib/utils";

export async function getStaticPaths() {
  const projekty = await getProjectsAndImages();
  return projekty.map((projekt) => ({
    params: { id: projekt.cleanId },
    props: { projekt },
  }));
}

interface Props {
  projekt: ProjectWithImages;
}

const { projekt } = Astro.props;

// Renderovanie obsahu z Markdown / Markdoc / MDX
const { Content } = await render(projekt.entry);
const { data } = projekt.entry;
---

<BaseLayout title={`${data.title} | BÄM!`}>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.css"
  />

  <article class="bg-white min-h-screen pt-32 pb-24">
    <!-- Hlavička projektu -->
    <header class="max-w-7xl mx-auto px-6 mb-16 md:mb-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 md:gap-12">
        <div class="max-w-4xl w-full">
          <a
            href="/projekty"
            class="label-tech text-[#0000FF] no-underline hover:text-black transition-colors mb-8 inline-block"
          >
            ← Projektový archív
          </a>
          
          <h1
            class="text-[10vw] sm:text-[7vw] md:text-7xl lg:text-8xl font-black italic tracking-tighter leading-[0.85] uppercase"
          >
            {data.title}
          </h1>
        </div>

        <!-- Meta údaje -->
        <div
          class="grid grid-cols-2 gap-y-6 gap-x-4 min-[450px]:flex min-[450px]:gap-12 border-l border-black/10 pl-6 md:pl-12 py-2"
        >
          <div>
            <span class="label-tech text-black/40 block mb-2 text-[10px]"
              >Lokalita</span
            >
            <span
              class="text-[11px] font-black uppercase italic tracking-wider block"
            >
              {data.location || "SR"}
            </span>
          </div>

          <div>
            <span class="label-tech text-black/40 block mb-2 text-[10px]"
              >Rok</span
            >
            <span
              class="text-[11px] font-black italic text-[#0000FF] tracking-wider block"
            >
              {data.year || "2026"}
            </span>
          </div>

          <div class="col-span-2 min-[450px]:col-auto">
            <span class="label-tech text-black/40 block mb-2 text-[10px]"
              >BÄM!</span
            >
            <span
              class="text-[11px] font-black italic uppercase text-[#0000FF] tracking-wider block"
            >
              {data.status || "Architektúra"}
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Hlavný Cover obrázok -->
    {
      projekt.coverImg && (
        <div class="max-w-7xl mx-auto px-6 mb-16 md:mb-20">
          <div class="w-full overflow-hidden bg-gray-100 border border-black/5">
            <Image
              src={projekt.coverImg}
              alt={data.title}
              class="w-full h-auto max-h-[50vh] lg:max-h-[60vh] object-cover"
              loading="eager"
            />
          </div>
        </div>
      )
    }

    <!-- Sekcia pre opis a koncept -->
    <div class="max-w-7xl mx-auto px-6 mb-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
        <div class="md:col-span-3">
          <div class="sticky top-32">
            <h2 class="label-tech text-[#0000FF] mb-4 md:mb-8">Koncept</h2>
          </div>
        </div>

        <div class="md:col-span-9">
          <!-- Popis z frontmatter / Keystatic field 'description' -->
          {
            data.description && (
              <p class="text-xl md:text-2xl text-black font-light leading-relaxed italic mb-8">
                {data.description}
              </p>
            )
          }

          <!-- Telo z Markdownu (všetok text vložený pod frontmatterom) -->
          <div class="prose prose-lg prose-neutral max-w-3xl prose-p:text-black/80 prose-p:text-xl prose-p:font-light prose-p:leading-[1.8] prose-p:italic">
            <Content />
          </div>
        </div>
      </div>
    </div>

    <!-- Galéria obrázkov -->
    {
      projekt.galleryImgs && projekt.galleryImgs.length > 0 && (
        <div class="max-w-7xl mx-auto px-6 mt-16 pt-12 border-t border-black/10">
          <div class="mb-12 flex justify-start">
            <h2 class="label-tech text-[#0000FF]">Galéria</h2>
          </div>

          <div
            id="gallery"
            class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"
          >
            {projekt.galleryImgs.map((img, index) => (
              <a
                href={img.src}
                data-pswp-width={img.width}
                data-pswp-height={img.height}
                target="_blank"
                rel="noreferrer"
                class="group relative block aspect-square overflow-hidden bg-gray-100 border border-black/5 hover:border-[#0000FF] transition-colors"
              >
                <Image
                  src={img}
                  alt={`${data.title} - Obrázok ${index + 1}`}
                  class="w-full h-full object-cover grayscale-0 lg:grayscale lg:group-hover:grayscale-0 transition-all duration-700 lg:group-hover:scale-110"
                  widths={[400, 800]}
                  sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
                />
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Prechod späť na projekty -->
    <footer class="max-w-7xl mx-auto px-6 mt-32 pt-16 border-t border-black">
      <a
        href="/projekty"
        class="group flex flex-col items-center text-center no-underline text-black"
      >
        <span
          class="text-4xl md:text-7xl font-black italic uppercase tracking-tighter leading-none group-hover:text-[#0000FF] transition-all"
        >
          Späť na projekty
          <span
            class="inline-block transition-transform group-hover:translate-x-4"
            >→</span
          >
        </span>
      </a>
    </footer>
  </article>

  <!-- PhotoSwipe Lightbox skript -->
  <script type="module">
    import PhotoSwipeLightbox from "https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe-lightbox.esm.js";
    import PhotoSwipe from "https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.esm.js";

    let lightbox;

    function initPhotoSwipe() {
      if (lightbox) {
        lightbox.destroy();
      }

      const galleryEl = document.getElementById("gallery");
      if (!galleryEl) return;

      lightbox = new PhotoSwipeLightbox({
        gallery: "#gallery",
        children: "a",
        pswpModule: PhotoSwipe,
        spacing: 0.05,
        allowPanToNext: true,
        closeTitle: "Zavrieť",
        zoomTitle: "Priblížiť",
        arrowPrevTitle: "Predchádzajúci",
        arrowNextTitle: "Nasledujúci",
      });

      lightbox.init();
    }

    initPhotoSwipe();
    document.addEventListener("astro:page-load", initPhotoSwipe);
  </script>
</BaseLayout>

<style is:global>
  .pswp {
    --pswp-bg: #000000;
    --pswp-icon-color: #ffffff;
    --pswp-icon-color-secondary: #0000ff;
  }
  .pswp__button {
    transition: all 0.3s ease;
  }
  .pswp__button:hover {
    background: rgba(0, 0, 255, 0.2) !important;
  }
</style>