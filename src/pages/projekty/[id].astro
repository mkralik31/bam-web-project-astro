---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// getStaticPaths pre dynamické routovanie zložiek
export async function getStaticPaths() {
  const projekty = await getCollection("projekty");
  return projekty.map((projekt) => {
    const cleanId = projekt.id.replace(/\/index$/, "").replace(/[^a-zA-Z0-9_-]/g, "-");

    return {
      params: { id: cleanId },
      props: { projekt },
    };
  });
}

interface Props {
  projekt: CollectionEntry<"projekty">;
}

const { projekt } = Astro.props;

// Názov priečinka projektu (napr. "01_byt-r")
const folderName = projekt.id.replace(/\/index$/, "");

// Načítame všetky obrázky z kolekcie
const allImagesMap = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/projekty/**/*.{jpeg,jpg,png,gif,webp,avif,JPEG,JPG,PNG,GIF,WEBP,AVIF}"
);

// Nájdeme COVER (súbor priamo v priečinku projektu, ktorý sa volá "cover")
const coverKey = Object.keys(allImagesMap).find((path) => {
  const isCorrectFolder = path.includes(`/src/content/projekty/${folderName}/`);
  const isNotInGallery = !path.includes("/gallery/");
  const isCoverName = path.toLowerCase().includes("cover");
  return isCorrectFolder && isNotInGallery && isCoverName;
});

const coverImage = coverKey ? await allImagesMap[coverKey]() : null;

// Nájdeme VŠETKY fotky v podpriečinku /gallery/
const galleryKeys = Object.keys(allImagesMap)
  .filter((path) =>
    path.includes(`/src/content/projekty/${folderName}/gallery/`)
  )
  .sort(); // Abecedné zoradenie

const galleryImages = await Promise.all(
  galleryKeys.map((key) => allImagesMap[key]())
);

// Astro render pre Markdown obsah
const { Content } = await render(projekt);
---

<BaseLayout title={`${projekt.data.title} | BAM STUDIO`}>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.css"
  />

  <article class="bg-white min-h-screen pt-32 pb-24">
    <header class="max-w-7xl mx-auto px-6 mb-16 md:mb-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-12">
        <div class="max-w-4xl">
          <a
            href="/projekty"
            class="label-tech text-[#0000FF] no-underline hover:text-black transition-colors mb-12 inline-block"
          >
            ← Archív projektov
          </a>
          <h1
            class="text-5xl md:text-8xl font-black italic tracking-tighter leading-[0.85] uppercase overflow-visible pr-4 whitespace-nowrap"
          >
            {projekt.data.title}
          </h1>
        </div>

        <div class="grid grid-cols-2 gap-y-6 gap-x-4 min-[450px]:flex min-[450px]:gap-12 border-l border-black/5 pl-6 md:pl-12 py-2">
          <div>
            <span class="label-tech text-black/30 block mb-2 text-[10px]">Lokalita</span>
            <span class="text-[11px] font-black uppercase italic tracking-wider block">
              {projekt.data.location || "SR"}
            </span>
          </div>

          <div>
            <span class="label-tech text-black/30 block mb-2 text-[10px]">Rok</span>
            <span class="text-[11px] font-black italic text-[#0000FF] tracking-wider block">
              {projekt.data.year || "2026"}
            </span>
          </div>

          <div class="col-span-2 min-[450px]:col-auto">
            <span class="label-tech text-black/30 block mb-2 text-[10px]">BÄM!</span>
            <span class="text-[11px] font-black italic uppercase text-[#0000FF] tracking-wider block">
              {projekt.data.type}
            </span>
          </div>
        </div>
      </div>
    </header>

    {
      coverImage && (
        <div class="mb-12">
          <Image
            src={coverImage.default}
            alt={projekt.data.title}
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      )
    }

    <div class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-3">
          <div class="sticky top-32">
            <h2 class="label-tech text-[#0000FF] mb-8">Koncept</h2>
          </div>
        </div>

        <div class="md:col-span-9">
          <div class="prose prose-lg prose-neutral max-w-3xl prose-p:text-black/70 prose-p:text-xl prose-p:font-light prose-p:leading-[1.8] prose-p:italic">
            {projekt.data.description && (
              <p class="text-xl md:text-2xl text-black/80 font-light leading-relaxed italic mb-12">
                {projekt.data.description}
              </p>
            )}
            <Content />
          </div>
        </div>
      </div>

      {
        galleryImages && galleryImages.length > 0 && (
          <div class="mt-24 pt-12 border-t border-black/5">
            <div class="mb-12 flex justify-start">
              <h2 class="label-tech text-[#0000FF]">Galéria</h2>
            </div>

            <div
              id="gallery"
              class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"
            >
              {galleryImages.map((img, index) => (
                <a
                  href={img.default.src}
                  data-pswp-width={img.default.width}
                  data-pswp-height={img.default.height}
                  target="_blank"
                  rel="noreferrer"
                  class="group relative block aspect-square overflow-hidden bg-gray-100 border border-black/5 hover:border-[#0000FF] transition-colors"
                >
                  <Image
                    src={img.default}
                    alt={`${projekt.data.title} - Obrázok ${index + 1}`}
                    class="w-full h-full object-cover grayscale-0 lg:grayscale lg:group-hover:grayscale-0 transition-all duration-700 lg:group-hover:scale-110"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <footer class="max-w-7xl mx-auto px-6 mt-40 pt-24 border-t border-black">
      <a
        href="/projekty"
        class="group flex flex-col items-center text-center no-underline text-black"
      >
        <span class="label-tech mb-6 opacity-40 group-hover:opacity-100 transition-opacity">
          Nasledujúci prieskum
        </span>
        <span class="text-4xl md:text-8xl font-black italic uppercase tracking-tighter leading-none group-hover:text-[#0000FF] transition-all overflow-visible pr-4">
          Späť do archívu
          <span class="inline-block transition-transform group-hover:translate-x-6">→</span>
        </span>
      </a>
    </footer>
  </article>

  <script type="module">
    import PhotoSwipeLightbox from "https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe-lightbox.esm.js";
    import PhotoSwipe from "https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.esm.js";

    function initPhotoSwipe() {
      const lightbox = new PhotoSwipeLightbox({
        gallery: "#gallery",
        children: "a",
        pswpModule: PhotoSwipe,
        spacing: 0.05,
        allowPanToNext: true,
        closeTitle: "Zavrieť",
        zoomTitle: "Priblížiť",
        arrowPrevTitle: "Predchádzajúci",
        arrowNextTitle: "Nasledujúci",
      });

      lightbox.init();
    }

    initPhotoSwipe();
    document.addEventListener("astro:page-load", initPhotoSwipe);
  </script>
</BaseLayout>

<style is:global>
  .pswp {
    --pswp-bg: #000000;
    --pswp-icon-color: #ffffff;
    --pswp-icon-color-secondary: #0000ff;
  }
  .pswp__button {
    transition: all 0.3s ease;
  }
  .pswp__button:hover {
    background: rgba(0, 0, 255, 0.1) !important;
  }
</style>