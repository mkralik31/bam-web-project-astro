---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjectsAndImages } from "../lib/utils";
import Hero from "../components/Hero.astro";
import FeaturedProjectsList from "../components/FeaturedProjectsList.astro";
import Footer from "../components/Footer.astro";

const sortedProjects = await getProjectsAndImages();

const featuredProjects = sortedProjects
  .filter((item) => item.entry.data.featured !== false)
  .slice(0, 6);

const hero = featuredProjects[0];
---

<BaseLayout title="Domov | BÄM!">
  <Hero project={hero}/>

  <div class="relative z-30 bg-white">
    <div class="border-t border-black px-8 py-6 bg-white">
      <div class="max-w-7xl mx-auto flex justify-center items-center">
        <span class="label-tech text-[#0000FF]">BÄM! projekty</span>
      </div>
    </div>

<div class="flex flex-col bg-white py-12 md:py-24">
      <FeaturedProjectsList projects={featuredProjects} />
    </div>
  </div>

  <div class="relative z-[25] sticky top-0">
    <Footer />
  </div>
</BaseLayout>

<script>
  let observer: IntersectionObserver | undefined;

  function initObserver() {
    if (observer) {
      observer.disconnect();
    }

    if (window.innerWidth < 768) {
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.8,
      };

      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          } else {
            entry.target.classList.remove("is-visible");
          }
        });
      }, observerOptions);

      if (observer) {
        // Zosúladené s anglickým názvom .project-card
        document.querySelectorAll(".project-card").forEach((card) => {
          observer!.observe(card);
        });
      }
    } else {
      document.querySelectorAll(".project-card").forEach((card) => {
        card.classList.remove("is-visible");
      });
    }
  }

  initObserver();

  let resizeTimeout: number | undefined;

  window.addEventListener("resize", () => {
    if (resizeTimeout) {
      clearTimeout(resizeTimeout);
    }
    resizeTimeout = window.setTimeout(initObserver, 200);
  });
</script>