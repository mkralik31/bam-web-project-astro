---
import KeystaticApp from '../../components/KeystaticApp';

export const prerender = true;

export const getStaticPaths = () => {
  return [
    { params: { file: undefined } },
    { params: { file: 'keystatic' } },
    { params: { file: 'cloud/oauth/callback' } },
    { params: { file: 'cloud/oauth/created-organization' } },
  ];
};
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Keystatic Admin</title>
    
    <!-- Fix pre Nginx: Odstránenie koncovej lomky, aby React Router našiel trasu -->
    <script>
      if (window.location.pathname.endsWith('/')) {
        var cleanUrl = window.location.pathname.replace(/\/$/, '') + window.location.search + window.location.hash;
        window.history.replaceState(null, '', cleanUrl);
      }
    </script>
  </head>
  <body>
    <KeystaticApp client:only="react" />
  </body>
</html>