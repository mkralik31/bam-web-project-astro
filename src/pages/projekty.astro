---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjectsAndImages } from "../lib/utils";
import ProjectsGrid from "../components/ProjectsGrid.astro";

const projects = await getProjectsAndImages();
---

<BaseLayout title="Projekty | BAM.">
  <main class="bg-white pt-8 md:pt-32 pb-24 px-6">
    <div class="max-w-7xl mx-auto">
      <header class="mb-20 md:mb-32">
        <h1
          class="text-6xl md:text-[10rem] font-black italic uppercase tracking-tighter leading-[0.8] mb-8 overflow-visible pr-4"
        >
          PROJEKTY<span class="text-[#0000FF]">!</span>
        </h1>
        <div
          class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-t border-black pt-8"
        >
        </div>
      </header>

      <ProjectsGrid projects={projects} />
    </div>
  </main>
</BaseLayout>