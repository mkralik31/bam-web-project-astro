<button
  id="back-to-top"
  aria-label="Návrat na vrch stránky"
  class="fixed bottom-24 right-4 md:bottom-8 md:right-8 z-[90] flex items-center justify-center w-12 h-12 rounded-full bg-black text-white border border-white/20 hover:bg-[#0000FF] hover:border-[#0000FF] transition-all duration-300 cursor-pointer group shadow-2xl"
>
  <span class="text-xl font-black transition-transform duration-300 group-hover:-translate-y-1">
    ↑
  </span>
</button>

<script>
  function initBackToTop() {
    const button = document.getElementById("back-to-top");
    if (!button) return;

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const handleScroll = () => {
      console.log("Aktuálny scrollY:", window.scrollY);
      if (window.scrollY > 100) {
        button.style.opacity = "1";
        button.style.pointerEvents = "auto";
        button.style.transform = "translateY(0)";
      } else {
        button.style.opacity = "0";
        button.style.pointerEvents = "none";
        button.style.transform = "translateY(80px)";
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  document.addEventListener("astro:page-load", initBackToTop);
  // Záloha ak nepoužívaš View Transitions
  if (document.readyState === "complete") {
    initBackToTop();
  } else {
    document.addEventListener("DOMContentLoaded", initBackToTop);
  }
</script>