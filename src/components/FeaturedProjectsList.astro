---
import { Image } from "astro:assets";
import type { ProjectWithImages } from "../lib/utils";

interface Props {
  projects: ProjectWithImages[];
}

const { projects } = Astro.props;
---

<div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 w-full flex flex-col gap-20 md:gap-32">
  {
    projects.map((project, index) => {
      const isEven = index % 2 === 0;
      const { entry, coverImg, cleanId } = project;
      const { title, year, location, status } = entry.data;

      const metaText = [status || "realizácia", year, location]
        .filter(Boolean)
        .join(", ");

      return (
        <article
          class={`project-card group flex flex-col md:flex-row items-center justify-between gap-8 md:gap-16 ${
            isEven ? "md:flex-row" : "md:flex-row-reverse"
          }`}
        >
          {/* Textový blok */}
          <div class="w-full md:w-1/2 flex flex-col items-start space-y-2">
            <h3 class="text-4xl md:text-6xl font-black italic uppercase tracking-wider text-[#0000FF] md:text-black md:group-hover:text-[#0000FF] transition-colors duration-300">
              <a href={`/projekty/${cleanId}`}>
                {title}
              </a>
            </h3>

            {metaText && (
              <p class="text-sm md:text-base text-gray-400 italic font-light">
                {metaText}
              </p>
            )}
          </div>

          {/* Statický rámik (výrez) */}
          <div class="w-full md:w-1/2">
            <a
              href={`/projekty/${cleanId}`}
              class="block w-full aspect-[4/3] overflow-hidden relative bg-gray-100"
            >
              {coverImg ? (
                <Image
                  src={coverImg}
                  alt={title}
                  format="webp"
                  class="w-full h-full object-cover grayscale-0 md:grayscale md:contrast-125 md:group-hover:grayscale-0 md:group-hover:contrast-100 transform-gpu transition-all duration-700 ease-out md:group-hover:scale-110"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs font-mono">
                  BEZ OBRÁZKU
                </div>
              )}
            </a>
          </div>
        </article>
      );
    })
  }
</div>