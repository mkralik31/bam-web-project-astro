---
import { Image } from "astro:assets";
import type { ProjectWithImages } from "../lib/utils";

interface Props {
  project: ProjectWithImages;
}

const { project } = Astro.props;
const { entry, coverImg, cleanId } = project;
const { title, year, location } = entry.data;
---

<a
  href={`/projekty/${cleanId}`}
  class="group block relative no-underline text-black"
>
  {/* Statický výrez s overflow-hidden */}
  <div class="overflow-hidden bg-gray-50 aspect-[16/10] mb-8 border border-black/5 relative">
    {coverImg ? (
      <Image
        src={coverImg}
        alt={title}
        format="webp"
        class="w-full h-full object-cover transform-gpu transition-all duration-700 ease-out grayscale-0 scale-100 lg:grayscale lg:group-hover:grayscale-0 lg:group-hover:scale-110"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-xs text-black/30 font-mono uppercase">
        Chýba cover image
      </div>
    )}
  </div>

  <div class="flex justify-between items-end">
    <div class="flex-1">
      <h2 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter leading-none group-hover:text-[#0000FF] transition-colors overflow-visible pr-4">
        {title}
      </h2>
      <div class="flex items-center gap-4 mt-4">
        <span class="label-tech text-[10px] text-black/40">
          {location || "Slovensko"}
        </span>
        <span class="w-8 h-[1px] bg-black/10" />
        <span class="label-tech text-[10px] text-[#0000FF]">
          {year}
        </span>
      </div>
    </div>

    <div class="flex flex-col items-end">
      <span class="text-[#0000FF] translate-x-4 opacity-0 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500 text-3xl italic font-black">
        &rarr;
      </span>
    </div>
  </div>

  <div class="absolute -bottom-10 left-0 w-full h-[1px] bg-black/5 group-hover:bg-[#0000FF] transition-colors duration-500" />
</a>