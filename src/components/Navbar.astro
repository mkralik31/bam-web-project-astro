---
---

<!-- Jeden jediný ostrovček navrhnutý pre mobil aj desktop -->
<div class="fixed bottom-6 md:bottom-auto md:top-8 inset-x-0 z-[100] px-4 md:px-6 pointer-events-none flex justify-center">
  <nav class="pointer-events-auto">
    <div
      class="bg-white/90 backdrop-blur-xl border border-black/5 px-8 md:px-10 py-3.5 md:py-4 rounded-full shadow-[0_15px_35px_rgba(0,0,0,0.12)] md:shadow-[0_20px_40px_rgba(0,0,0,0.08)] flex gap-8 md:gap-10 items-center justify-center"
    >
          <!-- Uvod -->
      <a
        href="/"
        class="nav-link group relative flex flex-col items-center no-underline transition-all duration-300 hover:-translate-y-0.5 hover:scale-105"
      >
        <span class="text-[10px] font-black italic uppercase tracking-[0.3em] md:tracking-[0.4em] text-[#0000FF]">
          Úvod
        </span>
        <div class="dot absolute -bottom-2 w-1 h-1 bg-[#0000FF] rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:bottom-[-8px] md:group-hover:bottom-[-10px] group-[.active]:opacity-100 group-[.active]:bottom-[-8px] md:group-[.active]:bottom-[-10px]"></div>
      </a>

      <!-- Projekty -->
      <a
        href="/projekty"
        class="nav-link group relative flex flex-col items-center no-underline transition-all duration-300 hover:-translate-y-0.5 hover:scale-105"
      >
        <span class="text-[10px] font-black italic uppercase tracking-[0.3em] md:tracking-[0.4em] text-[#0000FF]">
          Projekty
        </span>
        <div class="dot absolute -bottom-2 w-1 h-1 bg-[#0000FF] rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:bottom-[-8px] md:group-hover:bottom-[-10px] group-[.active]:opacity-100 group-[.active]:bottom-[-8px] md:group-[.active]:bottom-[-10px]"></div>
      </a>

      <!-- Kontakt -->
      <button
        id="open-contact"
        data-open-contact
        type="button"
        aria-label="Otvoriť kontaktný formulár"
        class="group relative flex flex-col items-center bg-transparent border-none p-0 cursor-pointer outline-none transition-all duration-300 hover:-translate-y-0.5 hover:scale-105"
      >
        <span class="text-[10px] font-black italic uppercase tracking-[0.3em] md:tracking-[0.4em] text-[#0000FF]">
          Kontakt
        </span>
        <div class="dot absolute -bottom-2 w-1 h-1 bg-[#0000FF] rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:bottom-[-8px] md:group-hover:bottom-[-10px]"></div>
      </button>
    </div>
  </nav>
</div>

<script>
  function initNavigation() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const contactBtns = document.querySelectorAll("[data-open-contact]");

    function setActiveLink() {
      const currentPath = window.location.pathname;

      navLinks.forEach((link) => {
        const href = link.getAttribute("href");
        link.classList.remove("active");

        if (href === "/" && currentPath === "/") {
          link.classList.add("active");
        } else if (
          href === "/projekty" &&
          currentPath.startsWith("/projekty")
        ) {
          link.classList.add("active");
        }
      });
    }

    function addClickFeedback(element: HTMLElement) {
      if (element.dataset.hasFeedback) return;
      element.dataset.hasFeedback = "true";

      element.addEventListener("mousedown", () => {
        element.style.transform = "scale(0.95)";
        element.style.transition = "transform 0.1s ease-out";
      });

      const resetTransform = () => {
        element.style.transform = "";
      };

      element.addEventListener("mouseup", resetTransform);
      element.addEventListener("mouseleave", resetTransform);
    }

    navLinks.forEach(addClickFeedback);
    contactBtns.forEach((btn) => addClickFeedback(btn as HTMLElement));

    setActiveLink();
  }

  initNavigation();
  document.addEventListener("astro:after-swap", initNavigation);
  document.addEventListener("astro:page-load", initNavigation);
</script>