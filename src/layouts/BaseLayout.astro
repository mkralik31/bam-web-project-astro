---
import "../styles/global.css";
import ScrollToTop from "../components/ScrollToTop.astro";
import ContactForm from "../components/ContactForm.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
const { title = "BAM!" } = Astro.props;
---

<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class="bg-white text-black antialiased selection:bg-[#0000FF] selection:text-white"
  >

    <Navbar />

    <main>
      <slot />
    </main>

    <!-- <ScrollToTop /> -->

    <ContactForm />

    <footer class="relative z-[25] sticky bottom-0">
      <Footer />
    </footer>

    <style is:global>
      :root {
        --brand-blue: #0000ff;
      }

      html {
        font-family: "Inter", system-ui, sans-serif;
        scroll-behavior: smooth;
        background-color: black;
      }

      /* Skrytie scrollbaru */
      body {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      body::-webkit-scrollbar {
        display: none;
      }

      /* Technicky popisok - JEDNOTNY STYL */
      .label-tech {
        font-size: 9px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5em !important;
        font-weight: 800 !important;
        font-style: italic !important;
        line-height: 1 !important;
        display: inline-block;
      }

      /* Animacie */
      @keyframes pulse-bg {
        0%,
        100% {
          opacity: 0.4;
          transform: scale(1.05);
        }
        50% {
          opacity: 0.2;
          transform: scale(1.1);
        }
      }

      .animate-pulse-slow {
        animation: pulse-bg 8s ease-in-out infinite;
      }

      /* Autofill fix pre tmavy rezim */
      input:-webkit-autofill,
      textarea:-webkit-autofill {
        -webkit-text-fill-color: white !important;
        -webkit-box-shadow: 0 0 0px 1000px black inset !important;
        transition: background-color 5000s ease-in-out 0s;
      }

      /* Grayscale pre tmavy rezim */
      @media (max-width: 767px) {
        .grayscale {
          transition: filter 0.8s ease-out !important;
          filter: grayscale(100%) !important;
        }
        .is-visible .grayscale {
          filter: grayscale(0%) !important;
        }

        .is-visible h3 {
          color: #0000ff !important;
        }

        h3 {
          transition: color 0.5s ease-out !important;
        }
      }

      /* Active link state */
      .nav-link.active > span {
        color: #0000ff !important;
      }

      .nav-link.active > div {
        bottom: -10px !important;
      }
    </style>

  </body>
</html>
